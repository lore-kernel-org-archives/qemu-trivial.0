> -    const uintptr_t dcache_lsize = 4 << extract32(ctr_el0, 16, 4);
> +    const uint64_t ctr_el0 = save_ctr_el0;
> +    const uintptr_t icache_lsize = 4 << extract64(ctr_el0, 0, 4);
